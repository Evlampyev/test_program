{% extends 'base.html' %}
{% load static %}
{% load custom_filters %}
{% block extra_css %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    {#    Мой файл css #}
    <link rel="stylesheet" href="{% static '/users_app/css/style.css' %}">
{% endblock %}

{% block title %}Личный кабинет ученика{% endblock %}

{% block content %}
    <div class="container mt-4">
        <!-- Информация о пользователе -->
        <div class="user-info d-flex align-items-center">
            <div class="user-avatar">
                <i class="fas fa-user-graduate"></i>
            </div>
            <div class="user-details">
                <h3>{{ user.last_name }} {{ user.first_name }} {{ user.middle_name }}</h3>
                <p>
                    <i class="fas fa-school me-2"></i>
                    {% if group %}
                        {{ group.school_class }} класс, Группа {{ group.number }}
                    {% else %}
                        Класс не назначен
                    {% endif %}
                </p>
                <p>
                    <i class="fas fa-envelope me-2"></i>
                    {{ user.username }}
                </p>
            </div>
        </div>
        <!-- Статистика (обновленная) -->
        <div class="row mb-4">
            <div class="col-md-4 mb-3">
                <div class="stats-card">
                    <div class="stats-icon">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="stats-number">{{ solved_tasks_count }}</div>
                    <div class="stats-label">Решено задач</div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="stats-card">
                    <div class="stats-icon">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="stats-number">{{ total_attempts }}</div>
                    <div class="stats-label">Всего попыток</div>
                </div>
            </div>
            <div class="col-md-4 mb-3">
                <div class="stats-card">
                    <div class="stats-icon">
                        <i class="fas fa-star"></i>
                    </div>
                    <div class="stats-number">{{ success_rate }}%</div>
                    <div class="stats-label">Успешность</div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Левая колонка: Последние задачи -->
            <div class="col-md-8">
                <div class="section-title">
                    <i class="fas fa-history me-2"></i>
                    Последние задачи
                </div>

                {% if group %}
                    <div class="mb-3">
                        <a href="{% url 'task_list' %}" class="btn btn-primary">
                            <i class="fas fa-plus-circle me-2"></i>
                            Выбрать новую задачу
                        </a>
                    </div>
                {% endif %}

                <!-- Список последних задач -->
                {% if tasks_stats %}
                    {% for task in tasks_stats %}
                        <div class="task-item">
                            <div class="d-flex align-items-center">
                                <span class="task-status {{ task.status_class }}"></span>
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">{{ task.title }}</h6>
                                    <small class="text-muted">
                                        {% if task.is_solved %}
                                            <i class="fas fa-check-circle text-success me-1"></i>
                                        {% else %}
                                            <i class="fas fa-hourglass-half text-warning me-1"></i>
                                        {% endif %}
                                        Попыток: {{ task.attempts_count }}
                                        <span class="ms-3">📊 Уровень: {{ task.level }}</span>
                                        {% if task.last_attempt %}
                                            <span class="ms-3">
                                        <i class="fas fa-calendar me-1"></i>
                                        {{ task.last_attempt.attempt_time|date:"d.m.Y H:i" }}
                                    </span>
                                        {% endif %}
                                    </small>

                                    <!-- Прогресс-бар (опционально) -->
                                    {% if not task.is_solved %}
                                        <div class="progress mt-2" style="height: 4px;">
                                            <div class="progress-bar bg-warning" role="progressbar"
                                                 style="width: {{ task.attempts_count|multiply:10 }}%"></div>
                                        </div>
                                    {% endif %}
                                </div>
                                <a href="{% url 'task_detail' task.id %}" class="btn btn-sm btn-outline-primary"
                                   style="width:5rem">
                                    {% if task.is_solved %}
                                        <i class="fas fa-eye"></i>
                                    {% else %}
                                        <i class="fas fa-play"></i>
                                    {% endif %}
                                </a>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        У вас пока нет попыток решения задач.
                        <a href="{% url 'task_list' %}">Выберите первую задачу!</a>
                    </div>
                {% endif %}
            </div>


            <!-- Правая колонка: Одноклассники -->
            <div class="col-md-4">
                <div class="section-title">
                    <i class="fas fa-users me-2"></i>
                    Моя группа
                </div>

                {% if group %}
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>{{ group.school_class }} - Группа {{ group.number }}</strong><br>
                        <small>Учитель:
                            {% if group.teacher %}
                                {{ group.teacher.last_name }} {{ group.teacher.first_name }}
                            {% else %}
                                не назначен
                            {% endif %}
                        </small>
                    </div>

                    {% if classmates %}
                        {% for classmate in classmates %}
                            <div class="classmate-item">
                                <div class="classmate-avatar">
                                    <i class="fas fa-user"></i>
                                </div>
                                <div>
                                    <strong>{{ classmate.last_name }} {{ classmate.first_name }}</strong><br>
                                    <small class="text-muted">
                                        <i class="fas fa-chart-line me-1"></i>
                                        Решено: {{ classmate.student_profile.solved_tasks|default:"0" }} задач
                                    </small>
                                </div>
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="text-center text-muted py-4">
                            <i class="fas fa-user-friends fa-3x mb-3"></i>
                            <p>В вашей группе пока нет других учеников</p>
                        </div>
                    {% endif %}
                {% else %}
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        Вам еще не назначена группа. Обратитесь к учителю.
                    </div>
                {% endif %}

                <!-- Рейтинг (пример) -->
                <div class="section-title mt-4">
                    <i class="fas fa-trophy me-2"></i>
                    Рейтинг группы
                </div>

                <div class="list-group">
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge bg-warning text-dark me-2">1</span>
                            Иванов Иван
                        </div>
                        <span class="badge bg-primary">15 задач</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge bg-secondary me-2">2</span>
                            Петров Петр
                        </div>
                        <span class="badge bg-primary">12 задач</span>
                    </div>
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <span class="badge bg-secondary me-2">3</span>
                            Сидорова Анна
                        </div>
                        <span class="badge bg-primary">10 задач</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block extra_js %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
{% endblock %}
