{% extends "base.html" %}
{% load static %}

{% block title %}{{ title }}{% endblock %}

{% block extra_css %}
    <link rel="stylesheet" href="{% static 'collections/css/collections.css' %}">
{% endblock %}

{% block content %}
    <div class="container mt-4">
        <!-- Заголовок -->
        <div class="attempt-header">
            <div class="d-flex justify-content-between align-items-center">
                <div class="col-6">
                    <h1>{{ attempt.collection.title }}</h1>
                    <p>{{ attempt.collection.description }}</p>
                    <div class="mt-2">
                        <span class="badge bg-light text-dark me-2">📚 {{ items|length }} задач</span>
                        <span class="badge bg-light text-dark">⭐ Макс. балл: {{ attempt.max_score }}</span>
                    </div>
                </div>
                {% if attempt.collection.time_limit %}
                    <div class="text-end col-2">
                        <div class="row">

                            <small class="text-white-50">осталось времени</small>
                        </div>
                        <div class="row">
                            <div class="timer" id="timer">--:--</div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Прогресс выполнения -->
        <div class="progress-tracker">
            <h5><i class="fas fa-chart-line me-2"></i>Прогресс выполнения</h5>
            <div class="progress" style="height: 10px;">
                <div class="progress-bar" id="progressBar" style="width: 0%;"></div>
            </div>
            <div class="progress-steps" id="progressSteps">
                {% for item in items %}
                    <div class="step" data-step="{{ forloop.counter0 }}" data-task-id="{{ item.task.id }}">
                        {{ forloop.counter }}
                    </div>
                {% endfor %}
            </div>
        </div>

        <!-- Задачи -->
        <div id="tasksContainer">
            {% for item in items %}
                <div class="task-card" data-task-id="{{ item.task.id }}" data-task-index="{{ forloop.counter0 }}"
                     data-max-score="{{ item.max_score }}">
                    <div class="task-header" onclick="toggleTask({{ forloop.counter0 }})">
                        <div>
                            <span class="task-number">{{ forloop.counter }}</span>
                            <strong>Задача #{{ item.task.id }}: {{ item.task.title }}</strong>
                        </div>
                        <div>
                    <span class="task-score me-2">
                        <i class="fas fa-star me-1"></i>{{ item.max_score }} баллов
                    </span>
                            <span class="task-status status-unsolved"
                                  id="status-{{ forloop.counter0 }}">⏳ Не решена</span>
                            <i class="fas fa-chevron-down ms-2"></i>
                        </div>
                    </div>
                    <div class="task-body" id="task-{{ forloop.counter0 }}">
                        <div class="task-condition-modal" id="task-description-{{ forloop.counter0 }}">
                            <div class="text-center py-4">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Загрузка...</span>
                                </div>
                            </div>
                        </div>
                        <textarea class="code-editor" id="code-{{ forloop.counter0 }}"
                                  placeholder="Напишите решение здесь..."></textarea>
                        <div class="result-message" id="result-{{ forloop.counter0 }}"></div>
                        <div class="task-actions">
                            <button class="btn-submit-task" onclick="submitSolution({{ forloop.counter0 }})">
                                <i class="fas fa-check me-2"></i>Проверить
                            </button>
                            {% if not forloop.last %}
                                <button class="btn-next" onclick="goToTask({{ forloop.counter0|add:1 }})">
                                    <i class="fas fa-arrow-right me-2"></i>Следующая задача
                                </button>
                            {% else %}
                                <button class="btn-next" onclick="finishCollection()">
                                    <i class="fas fa-check-double me-2"></i>Завершить контрольную
                                </button>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <!-- Кнопка завершения (внизу) -->
        <div class="finish-section row">
            <h3>Готовы сдать работу?</h3>
            <p>После завершения вы не сможете изменить свои ответы</p>
            <div class="col">
                <button class="btn btn-success btn-lg" onclick="finishCollection()">
                    <i class="fas fa-check-double me-2"></i>Завершить контрольную работу
                </button>
            </div>
            <div class="col">
                <a href="{% url 'tasks_&_collections:collections:detail' attempt.collection.id %}"
                   class="btn btn-secondary btn-lg ms-2">
                    <i class="fas fa-times me-2"></i>Выйти без сохранения
                </a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script>
        let currentTask = 0;
        let solutions = {};
        let taskResults = {};
        let startTime = null;
        let timerInterval = null;

        // Инициализация
        document.addEventListener('DOMContentLoaded', function () {
            // Проверяем, не завершена ли уже попытка
            const attemptStatus = '{{ attempt.status }}';  // Оборачиваем в кавычки
            if (attemptStatus === 'completed') {
                alert('Эта контрольная работа уже завершена');
                window.location.href = "{% url 'tasks_&_collections:collections:my_assignments' attempt.collection.id %}";
                return;
            }
            startTime = new Date();

            // Загружаем описания задач
            loadAllTasks();

            // Открываем первую задачу
            openTask(0);

            // Запускаем таймер
            {% if attempt.collection.time_limit %}
                startTimer();
            {% endif %}

            // Сохраняем решения при уходе
            window.addEventListener('beforeunload', function (e) {
                saveAllSolutions();
            });
        });

        // Загрузка всех задач
        function loadAllTasks() {
            {% for item in items %}
                fetch(`/tasks/api/task/{{ item.task.id }}/`)
                    .then(response => response.json())
                    .then(data => {
                        const mdContent = data.md_content || 'Описание отсутствует';
                        document.getElementById(`task-description-{{ forloop.counter0 }}`).innerHTML = marked.parse(mdContent);

                        // Загружаем сохраненное решение
                        const savedCode = localStorage.getItem(`collection_${{ attempt.id }}_task_{{ item.task.id }}`);
                        if (savedCode) {
                            document.getElementById(`code-{{ forloop.counter0 }}`).value = savedCode;
                            solutions[{{ forloop.counter0 }}] = savedCode;
                        }
                    })
                    .catch(error => {
                        console.error('Ошибка загрузки задачи:', error);
                        document.getElementById(`task-description-{{ forloop.counter0 }}`).innerHTML = '<p class="text-danger">Ошибка загрузки описания задачи</p>';
                    });
            {% endfor %}
        }

        // Открыть задачу
        function openTask(index) {
            // Закрываем все
            document.querySelectorAll('.task-body').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.step').forEach(el => el.classList.remove('current'));

            // Открываем выбранную
            document.getElementById(`task-${index}`).classList.add('active');
            document.querySelector(`.step[data-step="${index}"]`).classList.add('current');
            currentTask = index;

            // Прокручиваем к задаче
            document.getElementById(`task-${index}`).scrollIntoView({behavior: 'smooth', block: 'start'});
        }

        // Переключение задачи (сворачивание/разворачивание)
        function toggleTask(index) {
            const taskBody = document.getElementById(`task-${index}`);
            if (taskBody.classList.contains('active')) {
                taskBody.classList.remove('active');
            } else {
                openTask(index);
            }
        }

        // Переход к задаче
        function goToTask(index) {
            saveCurrentSolution();
            openTask(index);
        }

        // Сохранить текущее решение
        function saveCurrentSolution() {
            const code = document.getElementById(`code-${currentTask}`).value;
            const taskId = document.querySelector(`.task-card[data-task-index="${currentTask}"]`).dataset.taskId;
            solutions[currentTask] = code;
            localStorage.setItem(`collection_${{ attempt.id }}_task_${taskId}`, code);
        }

        // Сохранить все решения
        function saveAllSolutions() {
            for (let i = 0; i < {{ items|length }}; i++) {
                const code = document.getElementById(`code-${i}`).value;
                if (code) {
                    const taskId = document.querySelector(`.task-card[data-task-index="${i}"]`).dataset.taskId;
                    localStorage.setItem(`collection_${{ attempt.id }}_task_${taskId}`, code);
                }
            }
        }

        // Отправить решение на проверку
        async function submitSolution(index) {
            const taskId = document.querySelector(`.task-card[data-task-index="${index}"]`).dataset.taskId;
            const code = document.getElementById(`code-${index}`).value;
            const resultDiv = document.getElementById(`result-${index}`);
            const submitBtn = document.querySelector(`.task-card[data-task-index="${index}"] .btn-submit-task`);

            if (!code.trim()) {
                resultDiv.innerHTML = '<i class="fas fa-exclamation-triangle me-2"></i>Введите код решения';
                resultDiv.className = 'result-message result-error';
                resultDiv.style.display = 'block';
                setTimeout(() => resultDiv.style.display = 'none', 3000);
                return;
            }

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Проверка...';

            try {
                const response = await fetch('/tasks/api/check/', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRFToken': '{{ csrf_token }}'
                    },
                    body: JSON.stringify({
                        task_id: taskId,
                        code: code,
                        language: 'python'
                    })
                });

                const data = await response.json();

                if (data.success) {
                    resultDiv.innerHTML = `<i class="fas fa-check-circle me-2"></i>✅ Задача решена верно! (${data.tests_passed}/${data.total_tests} тестов пройдено)`;
                    resultDiv.className = 'result-message result-success';
                    document.getElementById(`status-${index}`).innerHTML = '✅ Решена';
                    document.getElementById(`status-${index}`).className = 'task-status status-solved';
                    taskResults[index] = true;

                    // Обновляем прогресс
                    updateProgress();
                } else {
                    resultDiv.innerHTML = `<i class="fas fa-times-circle me-2"></i>❌ ${data.message}`;
                    resultDiv.className = 'result-message result-error';
                    document.getElementById(`status-${index}`).innerHTML = '❌ Неверно';
                    taskResults[index] = false;
                }

                resultDiv.style.display = 'block';
                setTimeout(() => resultDiv.style.display = 'none', 5000);

            } catch (error) {
                resultDiv.innerHTML = '<i class="fas fa-exclamation-triangle me-2"></i>Ошибка при проверке решения';
                resultDiv.className = 'result-message result-error';
                resultDiv.style.display = 'block';
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fas fa-check me-2"></i>Проверить';
            }
        }

        // Обновление прогресса
        function updateProgress() {
            const total = {{ items|length }};
            const solved = Object.values(taskResults).filter(v => v === true).length;
            const percent = (solved / total) * 100;
            document.getElementById('progressBar').style.width = percent + '%';

            // Обновляем шаги
            for (let i = 0; i < total; i++) {
                if (taskResults[i]) {
                    document.querySelector(`.step[data-step="${i}"]`).classList.add('completed');
                }
            }
        }

        // Таймер
        function startTimer() {
            const timeLimit = {{ attempt.collection.time_limit }} * 60;
            const endTime = startTime.getTime() + (timeLimit * 1000);

            timerInterval = setInterval(function () {
                const now = new Date().getTime();
                const remaining = Math.max(0, Math.floor((endTime - now) / 1000));

                if (remaining <= 0) {
                    clearInterval(timerInterval);
                    document.getElementById('timer').innerHTML = '00:00';
                    alert('Время вышло! Контрольная работа будет завершена.');
                    finishCollection();
                    return;
                }

                const minutes = Math.floor(remaining / 60);
                const seconds = remaining % 60;
                document.getElementById('timer').innerHTML = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
            }, 1000);
        }

        // Завершение контрольной работы
        async function finishCollection() {
            if (confirm('Вы уверены, что хотите завершить контрольную работу? После завершения вы не сможете изменить свои ответы.')) {
                saveAllSolutions();

                const submitBtn = document.querySelector('.finish-section .btn-success');
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Отправка...';

                // Собираем результаты
                const results = [];
                for (let i = 0; i < {{ items|length }}; i++) {
                    const taskId = document.querySelector(`.task-card[data-task-index="${i}"]`).dataset.taskId;
                    const code = solutions[i] || '';
                    const isSolved = taskResults[i] || false;

                    results.push({
                        task_id: taskId,
                        code: code,
                        is_solved: isSolved
                    });
                }

                try {
                    const response = await fetch(`/tasks/collections/collection/{{ attempt.id }}/complete/`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRFToken': '{{ csrf_token }}'
                        },
                        body: JSON.stringify({
                            results: results
                        })
                    });

                    const data = await response.json();

                    if (data.success) {
                        // Очищаем localStorage
                        for (let i = 0; i < {{ items|length }}; i++) {
                            const taskId = document.querySelector(`.task-card[data-task-index="${i}"]`).dataset.taskId;
                            localStorage.removeItem(`collection_${{ attempt.id }}_task_${taskId}`);
                        }

                        alert(`Контрольная работа завершена!\nРезультат: ${data.score}/${data.max_score} баллов (${data.percentage}%)`);
                        window.location.href = `/tasks/collections/my-assignments/`;
                    } else {
                        alert('Ошибка при сохранении результатов');
                    }
                } catch (error) {
                    console.error('Ошибка:', error);
                    alert('Ошибка при завершении работы');
                } finally {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="fas fa-check-double me-2"></i>Завершить контрольную работу';
                }
            }
        }

        // Автосохранение каждые 30 секунд
        setInterval(saveAllSolutions, 30000);
    </script>
{% endblock %}