{% extends 'base.html' %}
{% load static %}

{% block extra_css %}
    {#    для красивого Python#}
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">
    {#    Мой файл css #}
    <link rel="stylesheet" href="{% static 'task_description_app/css/temp_tests.css' %}">
{% endblock %}

{% block content %}
     <style>
        /* ... все те же стили ... */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #f0f2f5;
            padding: 20px;
        }
        .container {
            display: flex;
            gap: 20px;
            max-width: 1400px;
            margin: 0 auto;
            height: calc(100vh - 40px);
        }
        .sidebar {
            width: 400px;
            background: white;
            border-radius: 12px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        .sidebar-header {
            padding: 16px;
            background: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
            font-weight: 600;
            display: flex;
            justify-content: space-between;
        }
        .tree-container {
            flex: 1;
            overflow-y: auto;
            padding: 12px;
        }
        .content {
            flex: 1;
            background: white;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }
        .content-header {
            padding: 20px;
            background: #f8f9fa;
            border-bottom: 1px solid #dee2e6;
        }
        .content-body {
            flex: 1;
            overflow-y: auto;
            padding: 24px;
        }

        /* Дерево */
        .tree, .tree ul {
            list-style: none;
            padding-left: 20px;
        }
        .tree {
            padding-left: 0;
        }
        .tree li {
            margin: 2px 0;
        }
        .tree .node {
            display: flex;
            align-items: center;
            padding: 6px 8px;
            border-radius: 6px;
            cursor: pointer;
            user-select: none;
            font-size: 14px;
        }
        .tree .node:hover {
            background: #e9ecef;
        }
        .tree .node.selected {
            background: #e3f2fd;
            color: #1976d2;
            font-weight: 500;
        }
        .arrow {
            display: inline-block;
            width: 20px;
            text-align: center;
            font-size: 12px;
            color: #6c757d;
        }
        .icon {
            margin-right: 8px;
            width: 20px;
            text-align: center;
        }
        .name {
            flex: 1;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .count {
            background: #e9ecef;
            padding: 2px 8px;
            border-radius: 20px;
            font-size: 11px;
            margin-left: 8px;
        }

        .tree ul {
            display: none;
        }
        .tree li.expanded > ul {
            display: block;
        }

        /* Стили для Markdown контента */
        .markdown-content {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
            line-height: 1.6;
            color: #24292e;
            padding: 20px;
            background: white;
            border-radius: 8px;
            border: 1px solid #e1e4e8;
        }

        .markdown-content h1 {
            font-size: 2em;
            border-bottom: 1px solid #eaecef;
            padding-bottom: 0.3em;
            margin-top: 24px;
            margin-bottom: 16px;
            font-weight: 600;
        }

        .markdown-content h2 {
            font-size: 1.5em;
            border-bottom: 1px solid #eaecef;
            padding-bottom: 0.3em;
            margin-top: 24px;
            margin-bottom: 16px;
            font-weight: 600;
        }

        .markdown-content h3 {
            font-size: 1.25em;
            margin-top: 24px;
            margin-bottom: 16px;
            font-weight: 600;
        }

        .markdown-content p {
            margin-top: 0;
            margin-bottom: 16px;
        }

        .markdown-content code {
            padding: 0.2em 0.4em;
            margin: 0;
            font-size: 85%;
            background-color: rgba(27,31,35,0.05);
            border-radius: 3px;
            font-family: 'SF Mono', Monaco, Consolas, 'Liberation Mono', Courier, monospace;
        }

        .markdown-content pre {
            padding: 16px;
            overflow: auto;
            font-size: 85%;
            line-height: 1.45;
            background-color: #f6f8fa;
            border-radius: 3px;
            margin-bottom: 16px;
        }

        .markdown-content pre code {
            padding: 0;
            margin: 0;
            font-size: 100%;
            word-break: normal;
            white-space: pre;
            background: transparent;
            border: 0;
        }

        .markdown-content blockquote {
            padding: 0 1em;
            color: #6a737d;
            border-left: 0.25em solid #dfe2e5;
            margin: 0 0 16px 0;
        }

        .markdown-content ul, .markdown-content ol {
            padding-left: 2em;
            margin-bottom: 16px;
        }

        .markdown-content table {
            border-collapse: collapse;
            width: 100%;
            margin-bottom: 16px;
        }

        .markdown-content table th,
        .markdown-content table td {
            padding: 6px 13px;
            border: 1px solid #dfe2e5;
        }

        .markdown-content table tr {
            background-color: #fff;
            border-top: 1px solid #c6cbd1;
        }

        .markdown-content table tr:nth-child(2n) {
            background-color: #f6f8fa;
        }

        /* Кнопка проверки */
        .check-button {
            display: inline-block;
            background: #28a745;
            color: white;
            padding: 12px 24px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 500;
            margin-top: 20px;
            border: none;
            cursor: pointer;
            font-size: 16px;
            transition: background 0.2s;
        }

        .check-button:hover {
            background: #218838;
        }

        .task-id {
            display: inline-block;
            background: #e9ecef;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 14px;
            color: #495057;
            margin-bottom: 16px;
            font-family: monospace;
        }

        .task-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 16px;
            border-bottom: 1px solid #e1e4e8;
        }

        .empty {
            color: #adb5bd;
            text-align: center;
            padding: 60px 20px;
        }
        .path {
            color: #6c757d;
            font-size: 14px;
            margin-bottom: 8px;
        }
        .loading {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid #f3f3f3;
            border-top: 3px solid #3498db;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-right: 10px;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        .loader-container {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
            color: #666;
        }
        .error-message {
            background: #ffebee;
            color: #c62828;
            padding: 20px;
            border-radius: 8px;
            border: 1px solid #ffcdd2;
        }
    </style>

 <div class="container">
        <!-- Левая панель -->
        <div class="sidebar">
            <div class="sidebar-header">
                <span>📁 Задачи</span>
                <span id="totalTasks">0</span>
            </div>
            <div class="tree-container">
                <ul class="tree" id="tree"></ul>
            </div>
        </div>

        <!-- Правая панель -->
        <div class="content">
            <div class="content-header">
                <div class="path" id="currentPath"></div>
                <h2 id="currentTitle">Выберите задачу</h2>
            </div>
            <div class="content-body" id="taskContent">
                <div class="empty">
                    👈 Выберите задачу в дереве слева
                </div>
            </div>
        </div>
    </div>

{% endblock %}

{% block extra_js %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/python.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="{% static 'task_description_app/js/task_detail.js' %}"></script>


{% endblock %}