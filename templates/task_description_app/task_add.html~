{% block extra_js %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Обновление предпросмотра пути
        function updatePathPreview() {
            const classVal = document.getElementById('id_class_name').value;
            const topicVal = document.getElementById('id_topic').value;
            const lessonVal = document.getElementById('id_lesson').value;
            const levelVal = document.getElementById('id_level').value;
            const taskFolder = document.getElementById('id_task_folder').value;

            const parts = [];
            if (classVal) parts.push(classVal);
            if (topicVal) parts.push(topicVal);
            if (lessonVal) parts.push(lessonVal);
            if (levelVal) parts.push(levelVal);
            if (taskFolder) parts.push(taskFolder);

            // Показываем путь в старой структуре (для информации)
            document.getElementById('pathPreview').textContent =
                parts.length > 0 ? '/tasks_for_tests/' + parts.join('/') : '/tasks_for_tests/...';

            // Добавляем информацию о новом месте хранения
            const newTaskId = document.getElementById('id_task_id')?.value || 'новый ID';
            console.log(`Файлы будут сохранены в: /tasks_for_tests/tasks/${newTaskId}/`);
        }

        // Слушатели для обновления пути
        document.getElementById('id_class_name').addEventListener('input', updatePathPreview);
        document.getElementById('id_topic').addEventListener('input', updatePathPreview);
        document.getElementById('id_lesson').addEventListener('input', updatePathPreview);
        document.getElementById('id_level').addEventListener('change', updatePathPreview);
        document.getElementById('id_task_folder').addEventListener('input', updatePathPreview);

        // Управление тестами
        let testCount = 0;
        const testsContainer = document.getElementById('testsContainer');
        const testCountInput = document.getElementById('testCount');

        function addTest() {
            testCount++;
            const testDiv = document.createElement('div');
            testDiv.className = 'test-card';
            testDiv.id = `test_${testCount}`;

            testDiv.innerHTML = `
            <div class="test-header">
                <span class="test-number">Тест #${testCount}</span>
                <span class="remove-test" onclick="removeTest(${testCount})">
                    <i class="fas fa-trash-alt"></i> Удалить
                </span>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <label class="form-label">Входные данные (test${testCount}.in)</label>
                    <textarea name="test_${testCount}_input" class="form-control test-input" rows="3" placeholder="Введите входные данные"></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Выходные данные (test${testCount}.out)</label>
                    <textarea name="test_${testCount}_output" class="form-control test-output" rows="3" placeholder="Введите ожидаемый результат"></textarea>
                </div>
            </div>
        `;

            testsContainer.appendChild(testDiv);
            testCountInput.value = testCount;
        }

        window.removeTest = function (id) {
            const testDiv = document.getElementById(`test_${id}`);
            if (testDiv) {
                testDiv.remove();
                // Перенумеровываем оставшиеся тесты
                const remainingTests = document.querySelectorAll('.test-card');
                remainingTests.forEach((test, index) => {
                    const newNum = index + 1;
                    test.id = `test_${newNum}`;
                    test.querySelector('.test-number').textContent = `Тест #${newNum}`;

                    const input = test.querySelector('.test-input');
                    const output = test.querySelector('.test-output');

                    input.name = `test_${newNum}_input`;
                    output.name = `test_${newNum}_output`;
                });
                testCount = remainingTests.length;
                testCountInput.value = testCount;
            }
        };

        document.getElementById('addTestBtn').addEventListener('click', addTest);

        // Добавляем первый тест автоматически
        window.addEventListener('load', function () {
            addTest();
        });

        // Отправка формы
        document.getElementById('taskAddForm').addEventListener('submit', function (e) {
            e.preventDefault();

            const formData = new FormData(this);
            const submitBtn = document.getElementById('submitBtn');
            const originalText = submitBtn.innerHTML;

            // Нормализуем переносы строк во всех textarea
            document.querySelectorAll('textarea').forEach(textarea => {
                textarea.value = textarea.value.replace(/\r\n/g, '\n');
            });

            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Создание задачи...';
            submitBtn.disabled = true;

            fetch('', {
                method: 'POST',
                body: formData,
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById('successMessage').textContent = data.message;
                        document.getElementById('successPath').textContent = data.path;
                        document.getElementById('successTaskId').textContent = data.task_id;

                        // Обновляем кнопку просмотра задачи
                        const viewBtn = document.querySelector('#successModal .btn-success');
                        if (viewBtn) {
                            viewBtn.href = `/tasks/task/${data.task_id}/`;
                        }

                        // Показываем модальное окно
                        new bootstrap.Modal(document.getElementById('successModal')).show();
                    } else {
                        let errorHtml = '<ul class="mb-0">';
                        for (let field in data.errors) {
                            errorHtml += `<li><strong>${field}:</strong> ${data.errors[field]}</li>`;
                        }
                        errorHtml += '</ul>';
                        document.getElementById('errorMessage').innerHTML = errorHtml;
                        new bootstrap.Modal(document.getElementById('errorModal')).show();
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    document.getElementById('errorMessage').innerHTML = 'Произошла ошибка при отправке формы: ' + error.message;
                    new bootstrap.Modal(document.getElementById('errorModal')).show();
                })
                .finally(() => {
                    submitBtn.innerHTML = originalText;
                    submitBtn.disabled = false;
                });
        });
    </script>
{% endblock %}