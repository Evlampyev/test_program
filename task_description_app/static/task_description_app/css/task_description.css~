/* static/task_description_app/css/task_description_app.css */

/* Для файла task_list.html */
.task-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
    padding: 20px;
    width: 100%;
}

.task-card {
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 20px;
    cursor: pointer;
    background: linear-gradient(455deg, #dadff3 0%, #a4d7de 100%);
    transition: transform 0.2s, box-shadow 0.2s;
}

.task-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

.task-card h3 {
    margin-top: 0;
    color: #333;
}

.task-id {
    color: #666;
    font-size: 0.9em;
}

/* Для файла task_detail.html */

/* Основной контейнер – две колонки ровно посередине экрана */
.grid-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: 20px;
    padding: 20px;
    min-height: calc(100vh - 100px); /* Чтобы занимать всю высоту */
    width: 100%;
    max-width: 1900px; /* ограничение ширины, но сохраняется центрирование */
}

/* Левая колонка — самостоятельный грид из двух строк */
.left-panel {
    display: grid;
    grid-template-rows: auto 1fr; /* первая строка по содержимому, вторая занимает остаток (по высоте левой колонки) */
    background-color: #ffffff;
    border-radius: 28px;
    box-shadow: 0 15px 35px -10px rgba(0, 20, 40, 0.2);
    padding: 24px;
    min-height: 0; /* важно для переполнения в grid-детях */
    border: 1px solid rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(2px);
}

/* Верхняя левая строка — высота только по контенту */
.task-description {
    border-right: 1px solid #ccc;
    padding: 18px 20px;
    margin-bottom: 16px; /* отступ от нижней строки (не входит в высоту грид-строки, т.к. грид gap не задан — используем margin) */
    background-color: #d9d4fa;
    border-radius: 20px;
    /*grid-row: 1; !* Первая строка, первая колонка *!*/
    /*overflow-y: auto; !* Скролл если много текста *!*/
    /*max-height: 50vh; !* Ограничиваем высоту *!*/
}


/* Нижняя левая строка — контент прижат к верхнему краю (собственное выравнивание) */
.upload-section-bottom {
    /*grid-column: 1; !* Первая колонка *!*/
    /*grid-row: 2; !* Вторая строка *!*/
    /*padding-right: 20px;*/
    /*align-items: start;*/
    background-color: #e7f0fd;
    border-radius: 20px;
    padding: 20px;
    border: 1px solid #b7c9e2;
    align-self: start; /* прижимает весь блок к верху грид-ячейки (т.к. ячейка .left-bottom занимает всю вторую строку по высоте) */
    display: flex;
    flex-direction: column;
    justify-content: flex-start; /* содержимое начинается с верхнего края */
    box-shadow: inset 0 2px 6px rgba(0, 20, 40, 0.04);
}

.upload-section {
    padding: 28px 24px;
    /*grid-row: 1 / span 2; !* Растягиваем на две строки *!*/
    /*display: flex;*/
    /*flex-direction: column;*/
    /*height: 100%;*/
    background: #ffffff;
    border-radius: 28px;
    box-shadow: 0 15px 30px -12px rgba(0, 30, 50, 0.25);
    padding: 28px 24px;
    border: 1px solid rgba(216, 225, 240, 0.8);
    height: fit-content; /* высота точно по содержимому */
    align-self: start; /* в гриде родителя .grid-split колонка не растягивается */
}

/* Стили для Markdown контента */
.markdown-content {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
    line-height: 1.6;
    color: #24292e;
    padding: 20px;
    margin-bottom: 10px;
    background: white;
    border-radius: 8px;
    border: 1px solid #e1e4e8;
}

.markdown-content h1 {
    font-size: 2em;
    border-bottom: 1px solid #eaecef;
    padding-bottom: 0.3em;
    margin-top: 12px;
    margin-bottom: 16px;
    font-weight: 600;
}

.markdown-content h2 {
    font-size: 1.5em;
    border-bottom: 1px solid #eaecef;
    padding-bottom: 0.3em;
    /*margin-top: 12px;*/
    margin-bottom: 8px;
    font-weight: 600;
}

.markdown-content h3 {
    font-size: 1.25em;
    margin-top: 24px;
    margin-bottom: 16px;
    font-weight: 600;
}

.markdown-content p {
    margin-top: 0;
    margin-bottom: 16px;
}

.markdown-content code {
    padding: 0.2em 0.4em;
    margin: 0;
    font-size: 85%;
    background-color: rgba(27, 31, 35, 0.05);
    border-radius: 3px;
    font-family: 'SF Mono', Monaco, Consolas, 'Liberation Mono', Courier, monospace;
}

.markdown-content pre {
    padding: 16px;
    overflow: auto;
    font-size: 85%;
    line-height: 1.45;
    background-color: #f6f8fa;
    border-radius: 3px;
    margin-bottom: 16px;
}

.markdown-content pre code {
    padding: 0;
    margin: 0;
    font-size: 100%;
    word-break: normal;
    white-space: pre;
    background: transparent;
    border: 0;
}

.markdown-content blockquote {
    padding: 0 1em;
    color: #6a737d;
    border-left: 0.25em solid #dfe2e5;
    margin: 0 0 16px 0;
}

.markdown-content ul, .markdown-content ol {
    padding-left: 2em;
    margin-bottom: 16px;
}

.markdown-content table {
    border-collapse: collapse;
    width: 100%;
    margin-bottom: 16px;
}

.markdown-content table th,
.markdown-content table td {
    padding: 6px 13px;
    border: 1px solid #dfe2e5;
}

.markdown-content table tr {
    background-color: #fff;
    border-top: 1px solid #c6cbd1;
}

.markdown-content table tr:nth-child(2n) {
    background-color: #f6f8fa;
}

.status {
    padding: 10px;
    border-radius: 5px;
    margin: 10px 0;
}

.status.uploaded {
    background: #e7f3ff;
}

.status.passed {
    background: #d4edda;
    color: #155724;
}

.status.failed {
    background: #f8d7da;
    color: #721c24;
}


/* Стили для демонстрации программы */
.program-display {
    background: #1e1e1e;
    color: #d4d4d4;
    padding: 15px;
    border-radius: 8px;
    font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
    font-size: 14px;
    line-height: 1.5;
    /*overflow-x: auto;*/
    /*max-height: 300px;*/
    overflow-y: auto;
    border: 1px solid #333;
}

.program-display pre {
    margin: 0;
    white-space: pre-wrap;
    word-wrap: break-word;
    color: #d4d4d4;
    background: transparent;
}

/* Стили для результатов тестирования */
#testResults {
    background: #f8f9fa;
    border-radius: 8px;
    padding: 15px;
    margin-top: 10px;
}

#testResultsPlaceholder {
    background: #f5f5f5;
    border-radius: 8px;
    padding: 20px;
    text-align: center;
    color: #666;
}

/* Адаптивность для мобильных устройств */
@media (max-width: 768px) {
    .grid-split {
        grid-template-columns: 1fr;
    }

    .task-description {
        border-right: none;
        padding-right: 0;
        max-height: none;
    }

    .upload-section {
        padding-left: 0;
    }

    .upload-section-bottom {
        margin-top: 20px;
    }

    .upload-form form div {
        flex-direction: column;
    }

    .upload-form input[type="file"] {
        width: 100%;
    }
}

/*Для файла task_list*/

.list-container {
    display: flex;
    gap: 20px;
    max-width: 1400px;
    margin: 0 auto;
    height: calc(100vh - 40px);
}

.sidebar {
    width: 400px;
    background: white;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.sidebar-header {
    padding: 16px;
    background: #f8f9fa;
    border-bottom: 1px solid #dee2e6;
    font-weight: 600;
    display: flex;
    justify-content: space-between;
}

.tree-container {
    flex: 1;
    overflow-y: auto;
    padding: 12px;
}

.list-content {
    flex: 1;
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

.list-content-header {
    padding: 20px;
    background: #f8f9fa;
    border-bottom: 1px solid #dee2e6;
}

.list-content-body {
    flex: 1;
    overflow-y: auto;
    padding: 24px;
}

/* Дерево */
.tree, .tree ul {
    list-style: none;
    padding-left: 20px;
}

.tree {
    padding-left: 0;
}

.tree li {
    margin: 2px 0;
}

.tree .node {
    display: flex;
    align-items: center;
    padding: 6px 8px;
    border-radius: 6px;
    cursor: pointer;
    user-select: none;
    font-size: 14px;
}

.tree .node:hover {
    background: #e9ecef;
}

.tree .node.selected {
    background: #e3f2fd;
    color: #1976d2;
    font-weight: 500;
}

.arrow {
    display: inline-block;
    width: 20px;
    text-align: center;
    font-size: 12px;
    color: #6c757d;
}

.icon {
    margin-right: 8px;
    width: 20px;
    text-align: center;
}

.list-name {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.list-count {
    background: #e9ecef;
    padding: 2px 8px;
    border-radius: 20px;
    font-size: 11px;
    margin-left: 8px;
}

.tree ul {
    display: none;
}

.tree li.expanded > ul {
    display: block;
}


.task-id {
    display: inline-block;
    background: #e9ecef;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 14px;
    color: #495057;
    margin-bottom: 16px;
    font-family: monospace;
}

.list-task-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 16px;
    border-bottom: 1px solid #e1e4e8;
}

.empty {
    color: #adb5bd;
    text-align: center;
    padding: 60px 20px;
}

.path {
    color: #6c757d;
    font-size: 14px;
    margin-bottom: 8px;
}

.loading {
    display: inline-block;
    width: 20px;
    height: 20px;
    border: 3px solid #f3f3f3;
    border-top: 3px solid #3498db;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-right: 10px;
}

@keyframes spin {
    0% {
        transform: rotate(0deg);
    }
    100% {
        transform: rotate(360deg);
    }
}

.loader-container {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px;
    color: #666;
}

.list-error-message {
    background: #ffebee;
    color: #c62828;
    padding: 20px;
    border-radius: 8px;
    border: 1px solid #ffcdd2;
}



/* Конец для файла task_list*/
