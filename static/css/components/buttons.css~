.btn {
    width: 100%;
    justify-content: center;
    padding: 18px 24px;
    border: none;
    border-radius: 10px;
    font-size: 1em;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
}

.btn-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
}

.btn-primary:hover, .btn-add-test:hover, .btn-secondary:hover, .btn-success:hover, .btn-warning:hover,
.btn-remove-image:hover, .btn-delete:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
    color: black;
}

.btn-add-test {
    background: white;
    border: 2px dashed #667eea;
    color: #667eea;
}

.btn-add-test:hover {
    background: #f0f4fa;
    border-color: #5a67d8;
}

.btn-secondary {
    background: #53565b;
    /*background: linear-gradient(208deg, #8586c0 0%, #a19a88 50%, #87597b 100%);*/
    color: white;
}

.btn-success {
    background: #398f65;
    color: white;
    /*background: linear-gradient(315deg, #C8FC5E, #99FCA5);*/
    /*background: linear-gradient(350deg, #a168ea 0%, #3aa425 100%)*/

}

.btn-warning {
    background: #604c17;
    color: white;
}

/*до сих пор проверил кнопк */
.btn-outline {
    background: transparent;
    color: #667eea;
    border: 2px solid #667eea;
    box-shadow: #6a737d 0px 2px 6px;
}

.btn-outline:hover {
    background: #667eea;
    color: white;
}

.btn-outline-sms {
    background: transparent;
    color: #13a4b2;
    border: 2px solid #13a4b2;
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
}

.btn-outline-sms:hover {
    background: #13a4b2;
    color: white;
}

.btn-outline-primary {
    background: transparent;
    border: 2px solid #135db2;
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
}

.logout-btn {
    color: white;
    text-decoration: none;
    padding: 4px 10px;
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.15);
    transition: all 0.3s;
}

.logout-btn:hover {
    background: rgba(255, 255, 255, 0.25);
    color: white;
}

.btn-export {
    background: #28a745;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 8px;
    transition: background 0.3s;
}

.btn-export:hover {
    background: #218838;
    color: white;
}

.btn-delete {
    background: #dc3545;
    color: white;
    border: none;
    border-radius: 10px;
    padding: 15px 30px;
    font-weight: 600;
    width: 100%;
}


.btn-remove-image {
    margin-top: 10px;
    background: #dc3545;
    color: white;
    border: none;
    padding: 5px 10px;
    border-radius: 5px;
    cursor: pointer;
    font-size: 12px;
}

.btn-remove-image:hover {
    background: #c82333;
}

